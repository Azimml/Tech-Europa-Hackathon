# Copy this file to .env and fill in your keys. Never commit .env.

# Reson8 speech-to-text (console.reson8.dev)
RESON8_API_KEY=

# Anthropic Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=

# Models. The scorer runs on every sentence, the agent runs once per scam.
SCORER_MODEL=claude-opus-5-5
SCORER_EFFORT=low
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=low

# Language of the call (Reson8 language code: en, de, nl, fr, it, pl, pt, es, sv, fy)
CALL_LANGUAGE=en

# Push notifications via ntfy.sh (install the ntfy app on the phone, subscribe to the topic).
# Use long random topic names: anyone who knows the name can read the messages.
NTFY_SERVER=https://ntfy.sh
NTFY_FAMILY_TOPIC=
NTFY_PHONE_TOPIC=

# Risk thresholds (0..1)
SCAM_THRESHOLD=0.8
CAUTION_THRESHOLD=0.5

PORT=3000
